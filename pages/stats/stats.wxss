.tabs {
  display: flex;
  padding: 8rpx;
  margin-bottom: 20rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--color-muted);
}

.tab.active {
  background: var(--color-primary);
  color: #fff;
  font-weight: 600;
}

.hero {
  padding: 28rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(145deg, #115e59, #0f766e 60%, #0d9488);
  color: #fff;
}

.range-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.nav-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.range-label {
  font-size: 28rpx;
  font-weight: 600;
}

.summary {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.label {
  font-size: 22rpx;
  opacity: 0.9;
}

.total {
  font-size: 56rpx;
  margin-top: 6rpx;
  color: #fff;
}

.count {
  font-size: 40rpx;
  font-weight: 700;
  margin-top: 6rpx;
}

.count-box {
  text-align: right;
}

.section {
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.section-head .section-title {
  margin-bottom: 0;
}

.filter {
  color: var(--color-primary);
  font-size: 24rpx;
}

.chart-scroll {
  width: 100%;
}

.chart {
  padding-top: 8rpx;
}

.bars {
  display: flex;
  align-items: flex-end;
  height: 220rpx;
  gap: 10rpx;
}

.bar-col {
  flex: 1;
  min-width: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.bar-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.bar {
  width: 28rpx;
  border-radius: 12rpx 12rpx 6rpx 6rpx;
  background: linear-gradient(180deg, #5eead4, #0f766e);
  min-height: 0;
}

.bar-label {
  font-size: 18rpx;
  margin-top: 8rpx;
  white-space: nowrap;
}

.cat-row,
.item-row,
.selected-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.cat-row:last-child,
.item-row:last-child {
  border-bottom: none;
}

.cat-left,
.selected-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.selected-head {
  width: 100%;
  margin-bottom: 8rpx;
}

.icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.name {
  font-size: 28rpx;
  font-weight: 600;
}

.sub {
  font-size: 22rpx;
}

.cat-right {
  width: 220rpx;
  text-align: right;
}

.money {
  font-size: 28rpx;
  color: var(--color-accent);
}

.bar-track {
  margin-top: 8rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #e5e7eb;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
}

.clear {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--color-primary) !important;
}

.empty-inline {
  padding: 24rpx 0;
  text-align: center;
}
