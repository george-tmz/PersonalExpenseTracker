.intro {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.intro-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.list {
  overflow: hidden;
  margin-bottom: 28rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.row:last-child {
  border-bottom: none;
}

.icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  color: #fff;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.meta {
  flex: 1;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tag {
  font-size: 20rpx;
  color: var(--color-primary);
  background: var(--color-primary-soft);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  font-weight: 500;
}

.sub {
  font-size: 22rpx;
  margin-top: 4rpx;
}

.arrow {
  font-size: 40rpx;
  line-height: 1;
}

.add {
  width: 100%;
}
