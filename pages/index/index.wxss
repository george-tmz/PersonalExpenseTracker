.hero {
  padding: 28rpx 28rpx 36rpx;
  margin-bottom: 28rpx;
  background: linear-gradient(145deg, #0f766e 0%, #0d9488 55%, #14b8a6 100%);
  color: #fff;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.date-nav {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.nav-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  line-height: 1;
}

.date-text {
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 8rpx;
}

.today-link {
  color: rgba(255, 255, 255, 0.9) !important;
  font-size: 24rpx;
}

.hero-total .label {
  font-size: 24rpx;
  opacity: 0.9;
}

.hero-total .total {
  font-size: 64rpx;
  margin: 8rpx 0;
  color: #fff;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin: 8rpx 8rpx 16rpx;
}

.list {
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.row:last-child {
  border-bottom: none;
}

.icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.meta {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
}

.note {
  font-size: 24rpx;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.money {
  font-size: 32rpx;
  color: var(--color-accent);
  margin-left: 16rpx;
}

.hint {
  text-align: center;
  font-size: 22rpx;
  margin-top: 16rpx;
}
