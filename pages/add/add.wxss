.amount-card {
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.label {
  font-size: 24rpx;
}

.amount-row {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}

.yen {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-primary);
  margin-right: 8rpx;
}

.amount-input {
  flex: 1;
  font-size: 64rpx;
  height: 88rpx;
  color: var(--color-text);
}

.block {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.block-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.cats {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 12rpx;
}

.cat {
  width: calc(25% - 12rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
}

.cat.active {
  background: var(--color-primary-soft);
  border-color: var(--color-primary);
}

.cat-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 18rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.cat-name {
  font-size: 22rpx;
  color: var(--color-text);
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.form-row:last-child {
  border-bottom: none;
}

.note-row {
  padding-top: 20rpx;
}

.form-label {
  width: 100rpx;
  color: var(--color-muted);
  flex-shrink: 0;
}

.form-value,
.form-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
}

.form-input {
  text-align: right;
}

.save {
  margin-top: 16rpx;
  width: 100%;
}

.delete {
  margin-top: 20rpx;
  width: 100%;
  color: #dc2626;
  border-color: #fecaca;
}
